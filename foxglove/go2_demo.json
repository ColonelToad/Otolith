{
  "configById": {
    "3D!a": {
      "cameraState": {
        "distance": 1.8,
        "perspective": true,
        "phi": 35,
        "thetaOffset": -35,
        "target": [0.5, 0, 0.2],
        "targetOrientation": [0, 0, 0, 1]
      },
      "followMode": "follow-pose",
      "followPose": { "frameId": "base" },
      "scene": { "enableStats": false, "backgroundColor": "#1e1e1e" },
      "layers": {
        "grid": { "visible": true, "color": "#333", "size": 10 },
        "tf": { "visible": true, "frameAxes": { "base": true, "base_gt": true } },
        "urdf": { "visible": true, "topic": "/robot_description", "frameId": "base" }
      },
      "topics": {
        "/tf": { "visible": true },
        "/otolith/gt_path": { "visible": true, "color": "#00ff00", "lineWidth": 2 },
        "/otolith/est_path": { "visible": true, "color": "#ff8800", "lineWidth": 2 },
        "/otolith/markers": { "visible": true }
      },
      "publish": { "type": "markerArray", "topic": "/otolith/markers" }
    },
    "Plot!b": {
      "title": "Velocity X: GT (green) vs Est (orange)",
      "paths": [
        { "label": "gt vx", "topic": "/otolith/ground_truth", "dataKey": "twist.twist.linear.x", "color": "#00ff00" },
        { "label": "est vx", "topic": "/otolith/state_estimate", "dataKey": "twist.twist.linear.x", "color": "#ff8800" }
      ],
      "yAxis": { "label": "m/s" },
      "xAxis": { "label": "t (s)" }
    },
    "Plot!c": {
      "title": "Contacts (FL FR RL RR) + Attitude error (see rpy_err.png)",
      "paths": [
        { "label": "FL", "topic": "/otolith/foot_contacts", "dataKey": "data[0]" },
        { "label": "FR", "topic": "/otolith/foot_contacts", "dataKey": "data[1]" },
        { "label": "RL", "topic": "/otolith/foot_contacts", "dataKey": "data[2]" },
        { "label": "RR", "topic": "/otolith/foot_contacts", "dataKey": "data[3]" }
      ]
    }
  },
  "layout": {
    "direction": "column",
    "first": "3D!a",
    "second": {
      "direction": "row",
      "first": "Plot!b",
      "second": "Plot!c"
    }
  },
  "globalVariables": {},
  "userNodes": {}
}
