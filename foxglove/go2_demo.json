{
  "_note": "Primary demo layout (hand-authored, full multi-panel). Path styling merged from go2_demo_export.json (gradient + lineWidth 0.1). Key settings: 3D > URDF layer Source=Topic /robot_description, Scene meshUpAxis=z_up THEN RESTART Studio (required), TF + Path (gt green, est orange) visible. Markers topic: keep HIDDEN for video (cov blob is bigger than the robot); enable with fusion param publish_covariance:=true for analysis. Do NOT set a topic color override on /otolith/markers (paints the blob opaque green). Diff vs go2_demo_export.json (3D-panel export): this file keeps follow-pose + close camera + TF layer on + grey grid #333333 + Plot panels; export has follow-heading, wider camera, TF transforms display off, blue grid #248eff, 3D only. See README in this folder.",
  "configById": {
    "3D!a": {
      "cameraState": {
        "distance": 1.8,
        "perspective": true,
        "phi": 35,
        "thetaOffset": -35,
        "target": [0.5, 0, 0.2],
        "targetOrientation": [0, 0, 0, 1]
      },
      "followMode": "follow-pose",
      "followPose": { "frameId": "base" },
      "scene": {
        "enableStats": false,
        "backgroundColor": "#1e1e1e",
        "meshUpAxis": "z_up"
      },
      "layers": {
        "grid": { "visible": true, "color": "#333333", "size": 10 },
        "tf": { "visible": true },
        "urdf": { "visible": true, "source": "topic", "topic": "/robot_description", "frameId": "base" }
      },
      "topics": {
        "/tf": { "visible": true },
        "/otolith/gt_path": {
          "visible": true,
          "gradient": ["#00ff00ff", "rgba(124, 107, 255, 0.5)"],
          "lineWidth": 0.1
        },
        "/otolith/est_path": {
          "visible": true,
          "gradient": ["#ff8800ff", "rgba(124, 107, 255, 0.5)"],
          "lineWidth": 0.1
        },
        "/otolith/markers": { "visible": true }
      }
    },
    "Plot!b": {
      "title": "Velocity X: GT (green) vs Est (orange)",
      "paths": [
        { "label": "gt vx", "topic": "/otolith/ground_truth", "dataKey": "twist.twist.linear.x", "color": "#00ff00" },
        { "label": "est vx", "topic": "/otolith/state_estimate", "dataKey": "twist.twist.linear.x", "color": "#ff8800" }
      ],
      "yAxis": { "label": "m/s" },
      "xAxis": { "label": "t (s)" }
    },
    "Plot!c": {
      "title": "Contacts (FL FR RL RR)",
      "paths": [
        { "label": "FL", "topic": "/otolith/foot_contacts", "dataKey": "data[0]" },
        { "label": "FR", "topic": "/otolith/foot_contacts", "dataKey": "data[1]" },
        { "label": "RL", "topic": "/otolith/foot_contacts", "dataKey": "data[2]" },
        { "label": "RR", "topic": "/otolith/foot_contacts", "dataKey": "data[3]" }
      ]
    }
  },
  "layout": {
    "direction": "column",
    "first": "3D!a",
    "second": { "direction": "row", "first": "Plot!b", "second": "Plot!c" }
  },
  "globalVariables": {},
  "userNodes": {}
}
